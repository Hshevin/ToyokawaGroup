# 复制为 keystore.properties 并填入真实值（该文件已 gitignore，勿提交）
#
# 生成 release 密钥库示例：
#   mkdir -p keystore
#   keytool -genkey -v \
#     -keystore keystore/release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias skyedge-release \
#     -storepass <storePassword> -keypass <keyPassword> \
#     -dname "CN=SkyEdge, OU=Dev, O=ToyokawaGroup, L=, ST=, C=CN"
#
# 查看 SHA1（用于高德等平台）：
#   keytool -list -v -keystore keystore/release.jks -alias skyedge-release

storeFile=keystore/release.jks
storePassword=
keyAlias=skyedge-release
keyPassword=
